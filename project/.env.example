# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# Key for tools/school_admin.py (16+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Database file (default: rfid_system.db next to app.py)
# RFID_DB=C:\rfid\rfid_system.db

# Server address and port
HOST=0.0.0.0
PORT=5001

# Accept taps from the original ESP32 sketch (no device key). Set to 0 once
# every reader runs rfid_reader v2 with its own device key.
ALLOW_LEGACY_TAP=1

# Desktop admin (app_ui.py) on another PC? Set to 0 (trusted network only).
LEGACY_ADMIN_LOCAL_ONLY=1

# Expo push (only for the old Expo app). 0 disables outgoing pushes.
PUSH_ENABLED=0

# Student session lifetimes
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Guardian SMS: none | log | semaphore | http
SMS_PROVIDER=none
# For semaphore (https://semaphore.co):
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER=SCHOOL
# For a generic HTTP gateway (POST JSON {"to": ..., "message": ...}):
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=
